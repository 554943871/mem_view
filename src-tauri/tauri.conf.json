{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "memView",
  "version": "0.1.1",
  "identifier": "local.memview",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "memView",
        "width": 1240,
        "height": 780,
        "minWidth": 920,
        "minHeight": 560,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
